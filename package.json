{
  "name": "jastipnisa",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "build:gas": "npm run typecheck && node scripts/build-gas.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "gas:validate": "node scripts/validate-gas.mjs",
    "gas:push": "npm run build:gas && npm run gas:validate && clasp push",
    "gas:deploy": "npm run gas:push && clasp deploy --description \"JastipNisa React + GAS\"",
    "dev:gas-demo": "vite --host 0.0.0.0 --port 3001 --mode gas-demo --open /index.gas.html"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
